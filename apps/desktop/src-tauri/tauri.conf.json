{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WTypora Foundation",
  "version": "0.1.0",
  "identifier": "com.wuming.wtypora.foundation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "无标题 — WTypora",
        "width": 1000,
        "height": 760,
        "minWidth": 580,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "txt"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ]
  }
}
